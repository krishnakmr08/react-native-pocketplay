{
  "expo": {
    "name": "react-native-pocketplay",
    "slug": "react-native-pocketplay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "reactnativepocketplay",
    "userInterfaceStyle": "automatic",

    "ios": {
      "bundleIdentifier": "com.krishnakmr.reactnativepocketplay"
    },

    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.krishnakmr.reactnativepocketplay"
    },

    "web": {
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash.png",
          "backgroundColor": "#1A1B28",
          "imageWidth": 100
        }
      ],

      [
        "react-native-video",
        {
          "enableNotificationControls": true,
          "androidExtensions": {
            "useExoplayerRtsp": false,
            "useExoplayerSmoothStreaming": true,
            "useExoplayerHls": true,
            "useExoplayerDash": false
          }
        }
      ],

      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.975184864340-1tla08b4jsd1147fld6nmhei35lqovtb"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
