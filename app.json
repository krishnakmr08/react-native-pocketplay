{
  "expo": {
    "name": "PocketPlay",
    "slug": "RNPocketPlay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "rnpocketplay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.krishnakmr.RNPocketPlay"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.krishnakmr.RNPocketPlay"
    },
    "web": {
      "output": "server",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1B28",
          "image": "./src/assets/images/splash.png",
          "imageWidth": 100
        }
      ],
      [
        "react-native-video",
        {
          "enableNotificationControls": true,
          "androidExtensions": {
            "useExoplayerRtsp": false,
            "useExoplayerSmoothStreaming": true,
            "useExoplayerHls": true,
            "useExoplayerDash": false
          }
        }
      ],

      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.959862155360-oiqn26o56bpsdruhhkanjjq3ck8tnum0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
